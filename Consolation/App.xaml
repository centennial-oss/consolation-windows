<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Consolation.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Consolation">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#CC11BB</Color>
            <Color x:Key="SystemAccentColorLight1">#DD43D0</Color>
            <Color x:Key="SystemAccentColorLight2">#EA76E0</Color>
            <Color x:Key="SystemAccentColorLight3">#F5B5EF</Color>
            <Color x:Key="SystemAccentColorDark1">#A70E99</Color>
            <Color x:Key="SystemAccentColorDark2">#810B76</Color>
            <Color x:Key="SystemAccentColorDark3">#5B0752</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#CC11BB" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#A70E99" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#810B76" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#665B0752" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnBrush" Color="#CC11BB" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOverBrush" Color="#DD43D0" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressedBrush" Color="#A70E99" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#CC11BB" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#DD43D0" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#A70E99" />
