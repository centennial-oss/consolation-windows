<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Consolation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Consolation">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <SolidColorBrush x:Key="GlassPanelBrush" Color="#4D242026" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="CapsuleBorderBrush" Color="#80FFFFFF" />

            <Style x:Key="CapsuleButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="112" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Background" Value="#18000000" />
                <Setter Property="BorderBrush" Value="{StaticResource CapsuleBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="RoundIconButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="#1CFFFFFF" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="White" />
            </Style>
        </Grid.Resources>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FF8C0573" />
                <GradientStop Offset="0.48" Color="#FF470330" />
                <GradientStop Offset="1" Color="#FF000000" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid
            x:Name="PlaybackViewer"
            Background="Black"
            PointerMoved="PlaybackViewer_PointerMoved"
            Visibility="Collapsed">
            <MediaPlayerElement
                x:Name="CapturePreviewElement"
                AreTransportControlsEnabled="False"
                Stretch="Uniform" />

            <Grid
                x:Name="ConnectingOverlay"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Black">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="Connecting to Capture Card ..." />
            </Grid>

        </Grid>

        <ScrollViewer
            x:Name="StartupForm"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="720" Padding="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Width="620"
                    Padding="28,26,28,30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource GlassPanelBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Border
                                Width="66"
                                Height="66"
                                Background="Transparent"
                                CornerRadius="16">
                                <Image Source="Assets/app-icon.png" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    FontSize="30"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Consolation" />
                                <TextBlock
                                    VerticalAlignment="Bottom"
                                    FontSize="16"
                                    Foreground="#CCFFFFFF"
                                    Text="v1.0.0" />
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="#33FFFFFF" />

                        <Grid ColumnSpacing="24" RowSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Device" />
                            <ComboBox
                                x:Name="DeviceComboBox"
                                Grid.Row="0"
                                Grid.Column="1"
                                Width="320"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Select capture device"
                                SelectionChanged="DeviceComboBox_SelectionChanged" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Resolution &amp; Frame Rate" />
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                Spacing="6">
                                <MenuBar x:Name="VideoModeMenuBar" Background="Transparent" IsEnabled="False">
                                    <MenuBarItem x:Name="ResolutionMenu" Title="No video modes" />
                                </MenuBar>
                                <TextBlock
                                    x:Name="SelectedModeText"
                                    Foreground="#CCFFFFFF"
                                    Text="Connect a capture card to choose a mode." />
                            </StackPanel>
                        </Grid>

                        <Button
                            x:Name="PlayButton"
                            Width="92"
                            Height="92"
                            HorizontalAlignment="Center"
                            Background="#668E7287"
                            BorderBrush="Transparent"
                            Click="PlayButton_Click"
                            CornerRadius="46">
                            <FontIcon
                                Margin="6,0,0,0"
                                FontSize="42"
                                Foreground="White"
                                Glyph="&#xE768;" />
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="18">
                    <Button
                        x:Name="SettingsButton"
                        Click="SettingsButton_Click"
                        Style="{StaticResource CapsuleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE713;" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="HelpButton_Click"
                        Style="{StaticResource CapsuleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE897;" />
                            <TextBlock Text="Help" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="AboutButton_Click"
                        Style="{StaticResource CapsuleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE946;" />
                            <TextBlock Text="About" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Canvas
            x:Name="ControlsLayer"
            SizeChanged="ControlsLayer_SizeChanged"
            Visibility="Collapsed">
            <Border
                x:Name="PlaybackControlsBar"
                Padding="10,5"
                Background="#E61B1B1D"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="24"
                PointerEntered="PlaybackControlsBar_PointerEntered"
                PointerExited="PlaybackControlsBar_PointerExited"
                PointerMoved="PlaybackControlsBar_PointerMoved"
                PointerPressed="PlaybackControlsBar_PointerPressed"
                PointerReleased="PlaybackControlsBar_PointerReleased">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Button
                        Click="StopPlaybackButton_Click"
                        Style="{StaticResource RoundIconButtonStyle}"
                        ToolTipService.ToolTip="Stop playback">
                        <FontIcon
                            FontSize="16"
                            Foreground="#FFFF424D"
                            Glyph="&#xE7E8;" />
                    </Button>

                    <Rectangle
                        Width="1"
                        Height="28"
                        Fill="#33FFFFFF" />

                    <Button
                        Click="VolumeButton_Click"
                        Style="{StaticResource RoundIconButtonStyle}"
                        ToolTipService.ToolTip="Mute">
                        <FontIcon
                            x:Name="VolumeButtonIcon"
                            FontSize="17"
                            Foreground="White"
                            Glyph="&#xE767;" />
                    </Button>
                    <Slider
                        x:Name="VolumeSlider"
                        Width="132"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="0"
                        Value="70"
                        ValueChanged="VolumeSlider_ValueChanged" />

                    <Rectangle
                        Width="1"
                        Height="34"
                        Fill="White" />

                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="White"
                        Glyph="&#xE8A3;" />
                    <Slider
                        Width="132"
                        VerticalAlignment="Center"
                        Maximum="200"
                        Minimum="50"
                        Value="100" />
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="White"
                        Glyph="&#xE8A3;" />

                    <Rectangle
                        Width="1"
                        Height="28"
                        Fill="#33FFFFFF" />

                    <Button
                        Click="SettingsButton_Click"
                        Style="{StaticResource RoundIconButtonStyle}"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon FontSize="17" Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>

        <Grid
            x:Name="ModalOverlay"
            Background="#66000000"
            Visibility="Collapsed">
            <Border
                x:Name="ModalSheet"
                Width="760"
                MaxWidth="760"
                Padding="34,32,34,26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F2282828"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="18">
                <Grid RowSpacing="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ContentControl x:Name="ModalTitleHost" />

                    <ScrollViewer
                        Grid.Row="1"
                        MaxHeight="620"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ContentControl x:Name="ModalContentHost" />
                    </ScrollViewer>

                    <Button
                        Grid.Row="2"
                        MinWidth="132"
                        Height="44"
                        Padding="24,0"
                        HorizontalAlignment="Right"
                        Background="#FF464646"
                        BorderBrush="Transparent"
                        Click="ModalCloseButton_Click"
                        Content="Close"
                        CornerRadius="22"
                        Foreground="White" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
